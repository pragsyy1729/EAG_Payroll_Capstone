          "name": "items",\
          "type": "children",\
          "required": false,\
          "shape": \{\
            "item_id": \{\
              "type": "link",\
              "to": "Item"\
            \},\
            "qty": \{\
              "type": "number",\
              "required": true\
            \},\
            "rate": \{\
              "type": "currency",\
              "default": 0\
            \},\
            "amount": \{\
              "type": "currency",\
              "computed": "qty * rate"\
            \},\
            "from_warehouse_id": \{\
              "type": "link",\
              "to": "Warehouse"\
            \},\
            "to_warehouse_id": \{\
              "type": "link",\
              "to": "Warehouse"\
            \},\
            "batch_id": \{\
              "type": "link",\
              "to": "Batch",\
              "description": "INV-28 \'97 no stock document carried a batch, so batch tracking was create-only: Batch.remaining_qty was written once at production and never decremented, and \\"which customer got batch X\\" could not be answered. Naming the batch on the line is what lets engine/hooks/inventory.py relieve it on issue."\
            \},\
            "serial_no": \{\
              "type": "text",\
              "description": "INV-28 \'97 comma-separated serial numbers on this line. Same reason as batch_id: SerialNumber rows were created at production and never moved, so a serial's whereabouts after it left the plant were unrecorded."\
            \}\
          \}\
        \},\
        \{\
          "name": "total_value",\
          "type": "currency",\
          "required": false,\
          "computed": "sum(items.amount)"\
        \},\
        \{\
          "name": "notes",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "status",\
          "type": "state",\
          "required": false,\
