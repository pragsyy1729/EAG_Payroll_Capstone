        \},\
        \{\
          "name": "purchase_requisition_id",\
          "type": "link",\
          "required": false,\
          "to": "PurchaseRequisition"\
        \},\
        \{\
          "name": "po_number",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "reference_number",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "date",\
          "type": "date",\
          "required": false\
        \},\
        \{\
          "name": "delivery_date",\
          "type": "date",\
          "required": false\
        \},\
        \{\
          "name": "payment_terms",\
          "type": "number",\
          "required": false\
        \},\
        \{\
          "name": "shipment_preference",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "source_of_supply",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "destination_of_supply",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "gst_no",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "gst_treatment",\
          "type": "select",\
          "required": false,\
          "options": [\
            "business_gst",\
            "business_composition",\
            "consumer",\
            "overseas",\
            "unregistered_business",\
            "sez",\
            "deemed_export"\
          ]\
        \},\
        \{\
          "name": "is_reverse_charge",\
          "type": "bool",\
          "required": false\
        \},\
        \{\
          "name": "items",\
          "type": "children",\
          "required": false,\
          "shape": \{\
            "item_id": \{\
              "type": "link",\
              "to": "Item"\
            \},\
            "account_id": \{\
              "type": "text"\
            \},\
            "description": \{\
              "type": "text"\
            \},\
            "qty": \{\
              "type": "number",\
              "required": true,\
              "default": 1\
            \},\
            "received_qty": \{\
              "type": "number",\
              "default": 0\
            \},\
            "billed_qty": \{\
              "type": "number",\
              "default": 0\
            \},\
            "rate": \{\
              "type": "currency",\
              "required": true\
            \},\
            "discount": \{\
              "type": "number",\
              "subtype": "percent",\
              "default": 0\
            \},\
            "tax_id": \{\
              "type": "text"\
            \},\
            "tax_percentage": \{\
              "type": "number"\
            \},\
            "hsn_or_sac": \{\
              "type": "text"\
            \},\
            "amount": \{\
              "type": "currency",\
              "computed": "qty * rate * (1 - discount / 100)"\
            \},\
            "cgst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "sgst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "igst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "cess_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "is_inclusive": \{\
              "type": "bool",\
              "default": false,\
              "_comment": "GST-20. Set from the document's `is_inclusive_tax` by engine/gst.py::apply_item_taxes. It lives on the LINE because `taxable_amount` is a child computed expression and a child cannot see its parent's columns."\
            \},\
            "taxable_amount": \{\
              "type": "currency",\
              "computed": "round(amount / (1 + is_inclusive * (cgst_rate + sgst_rate + utgst_rate + igst_rate + cess_rate) / 100), 2)",\
              "_comment": "GST-20. The value GST is charged on for THIS line, and the figure GSTR-1 table 12 declares per HSN. On an exclusive document it equals `amount`; on an inclusive one the tax is already inside `amount` and is extracted rather than added. The head amounts below read this, not `amount` \'97 computing them on the gross declared 18% more output tax than an inclusive invoice had collected."\
            \},\
            "cgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * cgst_rate / 100, 2)"\
            \},\
            "sgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * sgst_rate / 100, 2)"\
            \},\
            "igst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * igst_rate / 100, 2)"\
            \},\
            "cess_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * cess_rate / 100, 2)"\
            \},\
            "tds_name": \{\
              "type": "text"\
            \},\
            "tds_percentage": \{\
              "type": "number"\
            \},\
            "tds_amount": \{\
              "type": "currency"\
            \},\
            "tds_section_code": \{\
              "type": "text"\
            \},\
            "tds_section": \{\
              "type": "text"\
            \},\
            "reverse_charge_tax_name": \{\
              "type": "text"\
            \},\
            "reverse_charge_tax_rate": \{\
              "type": "number"\
            \},\
            "reverse_charge_tax_type": \{\
              "type": "text"\
            \},\
            "utgst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "utgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * utgst_rate / 100, 2)"\
            \}\
          \}\
        \},\
        \{\
          "name": "taxes",\
          "type": "children",\
          "required": false,\
          "shape": \{\
            "tax_type": \{\
              "type": "text"\
            \},\
            "rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "amount": \{\
              "type": "currency"\
            \}\
          \}\
        \},\
        \{\
          "name": "net_total",\
          "type": "currency",\
          "required": false,\
          "computed": "sum(items.amount)"\
        \},\
        \{\
          "name": "shipping_charge",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "adjustment",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "round_off",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "total_tax",\
          "type": "currency",\
          "required": false,\
          "computed": "max(sum(taxes.amount), sum(items.cgst_amount) + sum(items.sgst_amount) + sum(items.utgst_amount) + sum(items.igst_amount) + sum(items.cess_amount))"\
        \},\
        \{\
          "name": "taxable_value",\
          "type": "currency",\
          "required": false,\
          "computed": "round(net_total + shipping_charge + adjustment - total_tax * is_inclusive_tax, 2)"\
        \},\
        \{\
          "name": "is_inclusive_tax",\
          "type": "bool",\
          "required": false\
        \},\
        \{\
          "name": "grand_total",\
          "type": "currency",\
          "required": false,\
          "computed": "round(taxable_value + total_tax + tcs_amount - tds_amount + round_off, 2)"\
        \},\
        \{\
          "name": "discount",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "delivery_address",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "notes",\
          "type": "text",\
          "required": false\
        \},\
        \{\
