        "default": "MR-.YYYY.-.#####"\
      \},\
      "flow": \{\
        "name": "MaterialRequestFlow",\
        "states": [\
          "draft",\
          "submitted",\
          "partially_ordered",\
          "ordered",\
          "received",\
          "cancelled"\
        ],\
        "initial": "draft",\
        "transitions": [\
          \{\
            "from": "draft",\
            "to": "submitted",\
            "action": "Submit",\
            "role": "manufacturing_user",\
            "description": "Submit the material request for procurement; emits manufacturing.material_requested."\
          \},\
          \{\
            "from": "submitted",\
            "to": "partially_ordered",\
            "action": "Partially Order",\
            "role": "manufacturing_user",\
            "description": "Record that only some lines were ordered; the remaining lines stay open."\
          \},\
          \{\
            "from": "submitted",\
            "to": "ordered",\
            "action": "Order All",\
            "role": "manufacturing_user",\
            "description": "Mark every outstanding line of the request as ordered."\
          \},\
          \{\
            "from": "partially_ordered",\
            "to": "ordered",\
            "action": "Order All",\
            "role": "manufacturing_user",\
            "description": "Mark the remaining lines ordered and close the request's ordering stage."\
          \},\
          \{\
            "from": "ordered",\
            "to": "received",\
            "action": "Receive",\
            "role": "manufacturing_user",\
            "description": "Record receipt of the ordered materials and close the request."\
          \},\
          \{\
            "from": "draft",\
            "to": "cancelled",\
            "action": "Cancel",\
            "role": "admin",\
            "description": "Cancel the material request (admin only); nothing was ordered."\
          \},\
          \{\
            "from": "submitted",\
            "to": "cancelled",\
            "action": "Cancel",\
            "role": "admin",\
            "description": "Cancel a submitted material request (admin only)."\
          \}\
        ]\
      \}\
    \},\
