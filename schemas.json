            "sgst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "igst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "cess_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "is_inclusive": \{\
              "type": "bool",\
              "default": false,\
              "_comment": "GST-20. Set from the document's `is_inclusive_tax` by engine/gst.py::apply_item_taxes. It lives on the LINE because `taxable_amount` below is a child computed expression and a child cannot see its parent's columns."\
            \},\
            "taxable_amount": \{\
              "type": "currency",\
              "computed": "round(amount / (1 + is_inclusive * (cgst_rate + sgst_rate + utgst_rate + igst_rate + cess_rate) / 100), 2)",\
              "_comment": "GST-20. The value GST is charged on for THIS line, and the figure GSTR-1 table 12 declares per HSN. On an exclusive document it is `amount`; on an inclusive one the tax is already inside `amount`, so it is extracted rather than added. The five head amounts below read this, not `amount` \'97 computing them on the gross declared 18% more output tax than an inclusive invoice had collected."\
            \},\
            "cgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * cgst_rate / 100, 2)"\
            \},\
            "sgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * sgst_rate / 100, 2)"\
            \},\
            "igst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * igst_rate / 100, 2)"\
