            "from": "draft",\
            "to": "cancelled",\
            "action": "Cancel",\
            "description": "Cancel a draft work order (admin only); no stock or GL has moved yet.",\
            "role": "admin"\
          \},\
          \{\
            "from": "not_started",\
            "to": "cancelled",\
            "action": "Cancel",\
            "description": "Cancel a submitted work order (admin only); job cards exist but no stock has posted.",\
            "role": "admin"\
          \},\
          \{\
            "from": "in_progress",\
            "to": "cancelled",\
            "action": "Cancel",\
