            "utgst_rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "utgst_amount": \{\
              "type": "currency",\
              "computed": "round(taxable_amount * utgst_rate / 100, 2)"\
            \}\
          \}\
        \},\
        \{\
          "name": "taxes",\
          "type": "children",\
          "required": false,\
          "shape": \{\
            "tax_type": \{\
              "type": "text"\
            \},\
            "rate": \{\
              "type": "number",\
              "subtype": "percent"\
            \},\
            "amount": \{\
              "type": "currency"\
            \}\
          \}\
        \},\
        \{\
          "name": "net_total",\
          "type": "currency",\
          "required": false,\
          "computed": "sum(items.amount)"\
        \},\
        \{\
          "name": "shipping_charge",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "adjustment",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "round_off",\
          "type": "currency",\
          "required": false\
        \},\
        \{\
          "name": "total_tax",\
          "type": "currency",\
          "required": false,\
          "computed": "max(sum(taxes.amount), sum(items.cgst_amount) + sum(items.sgst_amount) + sum(items.utgst_amount) + sum(items.igst_amount) + sum(items.cess_amount))"\
        \},\
        \{\
          "name": "taxable_value",\
          "type": "currency",\
          "required": false,\
          "computed": "round(net_total + shipping_charge + adjustment - total_tax * is_inclusive_tax, 2)"\
        \},\
        \{\
          "name": "is_inclusive_tax",\
          "type": "bool",\
          "required": false\
