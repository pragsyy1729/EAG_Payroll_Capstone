      "flow": \{\
        "name": "EmailFlow",\
        "states": [\
          "draft",\
          "queued",\
          "sending",\
          "sent",\
          "received",\
          "bounced",\
          "failed"\
        ],\
        "initial": "draft",\
        "transitions": [\
          \{\
            "from": "draft",\
            "to": "draft",\
            "action": "Save Draft",\
            "role": "user"\
          \},\
          \{\
            "from": "draft",\
            "to": "sent",\
            "action": "Record Sent",\
            "role": "user",\
            "condition": \{\
              "expression": "folder == \\"sent\\" and (sent_at or \\"\\") != \\"\\"",\
              "message": "Record Sent files a message that was ALREADY sent elsewhere: set folder='sent' and sent_at on the message first. To send a message, use POST /api/email/message/\{id\}/send (MCP: endpoint.email.messages.send)."\
            \}\
          \},\
          \{\
            "from": "draft",\
            "to": "queued",\
            "action": "Queue Send",\
            "role": "system"\
          \},\
          \{\
            "from": "queued",\
            "to": "sending",\
            "action": "Process Queue",\
            "role": "system"\
          \},\
          \{\
            "from": "sending",\
            "to": "sent",\
            "action": "Delivery Confirmed",\
            "role": "system"\
          \},\
          \{\
            "from": "sending",\
            "to": "bounced",\
            "action": "Bounce Received",\
            "role": "system"\
          \},\
          \{\
            "from": "sending",\
            "to": "failed",\
            "action": "Send Failed",\
            "role": "system"\
          \},\
          \{\
            "from": "failed",\
            "to": "queued",\
            "action": "Retry Send",\
            "role": "system"\
          \}\
        ]\
      \}\
    \},\
