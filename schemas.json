        ],\
        "user": [\
          "read",\
          "create",\
          "write",\
          "submit"\
        ]\
      \},\
      "children": \{\
        "items": \{\
          "shape": \{\
            "item_id": \{\
              "type": "link",\
              "to": "Item"\
            \},\
            "qty": \{\
              "type": "number",\
              "required": true\
            \},\
            "rate": \{\
              "type": "currency",\
              "default": 0\
            \},\
            "amount": \{\
              "type": "currency",\
              "computed": "qty * rate"\
            \},\
            "from_warehouse_id": \{\
              "type": "link",\
              "to": "Warehouse"\
            \},\
            "to_warehouse_id": \{\
              "type": "link",\
              "to": "Warehouse"\
            \},\
            "batch_id": \{\
              "type": "link",\
              "to": "Batch",\
              "description": "INV-28 \'97 no stock document carried a batch, so batch tracking was create-only: Batch.remaining_qty was written once at production and never decremented, and \\"which customer got batch X\\" could not be answered. Naming the batch on the line is what lets engine/hooks/inventory.py relieve it on issue."\
            \},\
            "serial_no": \{\
              "type": "text",\
              "description": "INV-28 \'97 comma-separated serial numbers on this line. Same reason as batch_id: SerialNumber rows were created at production and never moved, so a serial's whereabouts after it left the plant were unrecorded."\
            \}\
          \}\
        \}\
      \},\
      "number_format": \{\
        "receive": "GRN-.YYYY.-.#####.",\
        "issue": "DN-.YYYY.-.#####.",\
        "transfer": "STE-.YYYY.-.#####.",\
        "manufacture": "MFG-.YYYY.-.#####.",\
        "return": "RTN-.YYYY.-.#####."\
      \},\
      "flow": \{\
        "name": "StockEntryFlow",\
        "states": [\
          "draft",\
          "submitted",\
          "cancelled"\
        ],\
        "initial": "draft",\
        "transitions": [\
          \{\
            "from": "draft",\
            "to": "submitted",\
            "action": "Submit",\
            "role": "any",\
            "reverse": \{\
              "action": "Cancel",\
              "to": "cancelled"\
            \},\
            "description": "Submit the stock entry: posts the stock ledger and the GL for the movement and locks the entry from edits."\
          \},\
          \{\
            "from": "draft",\
            "to": "cancelled",\
            "action": "Cancel Draft",\
            "role": "any",\
            "description": "Discard a draft stock entry; nothing has posted, so nothing is reversed."\
          \},\
          \{\
            "from": "submitted",\
            "to": "cancelled",\
            "action": "Cancel",\
            "role": "admin",\
            "description": "Cancel a submitted stock entry (admin only): reverses the posted stock ledger and GL with a dated counter-voucher."\
          \}\
        ]\
      \}\
    \},\
