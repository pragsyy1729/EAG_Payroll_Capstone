            "role": "manufacturing_user"\
          \},\
          \{\
            "from": "in_progress",\
            "to": "stopped",\
            "action": "Stop",\
            "description": "Stop production and record why; the order stays at stopped and can be resumed.",\
            "role": "manufacturing_user"\
          \},\
          \{\
            "from": "stopped",\
            "to": "in_progress",\
            "action": "Resume",\
            "description": "Resume a stopped work order and return it to in_progress.",\
