      "entity": "SupplierQuotation",\
      "domain": "accounting",\
      "kind": "transaction",\
      "behaviors": [\
        "numberable"\
      ],\
      "reserved_behaviors": [\
        "commentable"\
      ],\
      "fields": [\
        \{\
          "name": "company_id",\
          "type": "link",\
          "required": false,\
          "to": "Company"\
        \},\
        \{\
          "name": "rfq_id",\
          "type": "link",\
          "required": false,\
          "to": "PurchaseRfq"\
        \},\
        \{\
          "name": "vendor_id",\
          "type": "link",\
          "required": true,\
          "to": "Party"\
        \},\
        \{\
          "name": "date",\
          "type": "date",\
          "required": false\
        \},\
        \{\
          "name": "valid_till",\
          "type": "date",\
          "required": false\
        \},\
        \{\
          "name": "items",\
          "type": "children",\
          "required": false,\
          "shape": \{\
            "rfq_line_key": \{\
              "type": "text"\
            \},\
            "item_id": \{\
              "type": "link",\
              "to": "Item"\
            \},\
            "qty_break": \{\
              "type": "number",\
              "description": "C-037 \'97 the quantity this rate applies from. Carbon quotes per quantity break; a line with no break is a flat rate."\
            \},\
            "rate": \{\
              "type": "currency",\
              "required": true,\
              "default": 0\
            \},\
            "lead_time_days": \{\
              "type": "number",\
              "default": 0\
            \},\
            "amount": \{\
              "type": "currency",\
              "computed": "qty_break * rate"\
            \}\
          \}\
        \},\
        \{\
          "name": "total",\
          "type": "currency",\
          "required": false,\
          "computed": "sum(items.amount)"\
        \},\
        \{\
          "name": "notes",\
          "type": "text",\
          "required": false\
        \},\
        \{\
          "name": "status",\
          "type": "state",\
          "required": false,\
          "flow": "SupplierQuotationFlow"\
        \}\
      ],\
      "permissions": \{\
        "admin": [\
          "read",\
          "create",\
          "write",\
          "submit",\
          "cancel",\
          "delete"\
        ],\
        "finance_admin": [\
          "read",\
          "create",\
          "write",\
          "cancel"\
        ],\
        "finance_user": [\
          "read",\
          "create",\
          "write",\
          "submit"\
        ],\
        "project_user": [\
          "read",\
          "create"\
        ],\
        "user": [\
          "read",\
          "create"\
        ]\
      \},\
      "children": \{\
        "items": \{\
          "shape": \{\
            "rfq_line_key": \{\
              "type": "text"\
            \},\
            "item_id": \{\
              "type": "link",\
              "to": "Item"\
            \},\
            "qty_break": \{\
              "type": "number",\
              "description": "C-037 \'97 the quantity this rate applies from. Carbon quotes per quantity break; a line with no break is a flat rate."\
            \},\
            "rate": \{\
              "type": "currency",\
              "required": true,\
              "default": 0\
            \},\
            "lead_time_days": \{\
              "type": "number",\
              "default": 0\
            \},\
            "amount": \{\
              "type": "currency",\
              "computed": "qty_break * rate"\
            \}\
          \}\
        \}\
      \},\
      "number_format": \{\
        "default": "SQ-.YYYY.-.#####."\
      \},\
      "flow": \{\
        "name": "SupplierQuotationFlow",\
        "states": [\
          "received",\
          "selected",\
          "rejected"\
        ],\
        "initial": "received",\
        "transitions": [\
          \{\
            "from": "received",\
            "to": "selected",\
            "action": "Select",\
            "role": "finance_user"\
          \},\
          \{\
            "from": "received",\
            "to": "rejected",\
            "action": "Reject",\
            "role": "finance_user"\
          \}\
        ]\
      \}\
    \},\
